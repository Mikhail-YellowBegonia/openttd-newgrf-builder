switch(FEAT_HOUSES, SELF, test1_2x2_layout, house_tile) {
    HOUSE_TILE_NORTH: test1_2x2_full_layout;
    test1_2x2_empty_layout;
}

item(FEAT_HOUSES, test1_2x2_house, 129, HOUSE_SIZE_2X2) {
    property {
        substitute: 20;
        name: string(STR_HOUSE_TOWN);
        /* NML probability 1 emits raw Action 0 probability 16. */
        probability: 1;
        population: 1;
        availability_mask: [ALL_TOWNZONES, bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPIC, CLIMATE_TOYLAND, ABOVE_SNOWLINE)];
        /* NML emits 0x30, 0x20, 0x20, 0x20 for the four tiles. */
        building_flags: 0x20;
    }

    graphics {
        default: test1_2x2_layout;
    }
}

